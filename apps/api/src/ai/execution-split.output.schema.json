{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "target", "ownerHint", "required", "dependsOnIndexes", "verification"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "target": { "type": "string", "minLength": 1, "maxLength": 80 },
          "ownerHint": { "type": ["string", "null"], "maxLength": 200 },
          "required": { "type": "boolean" },
          "dependsOnIndexes": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
        }
      }
    }
  }
}
